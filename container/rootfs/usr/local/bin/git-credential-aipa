#!/bin/sh
# git credential helper for agent containers: answers github.com requests with
# the bot token from the read-only /run/aipa mount, read fresh on every call so
# a token the host broker has just rotated takes effect immediately.
TOKEN_FILE=${AIPA_TOKEN_FILE:-/run/aipa/gh-token}
cat >/dev/null   # consume the request git writes to stdin
[ "${1:-}" = get ] || exit 0
if [ ! -r "$TOKEN_FILE" ]; then
  echo "git-credential-aipa: no bot token at $TOKEN_FILE. Is the host token broker running?" >&2
  exit 1
fi
printf 'username=x-access-token\npassword=%s\n' "$(cat "$TOKEN_FILE")"
