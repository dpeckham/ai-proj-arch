# Agent image for one ai-proj-arch project container.
#
# Build with `aipa build-image`, which passes the pinned versions and checksums
# from container/versions.env as build arguments. Every download is verified
# against a pinned SHA-256; the build fails on any mismatch.

FROM docker.io/library/debian:stable-slim

ARG GH_VERSION
ARG GH_SHA256_ARM64
ARG GH_SHA256_AMD64
ARG CODEX_VERSION
ARG CODEX_SHA256_ARM64
ARG CODEX_SHA256_AMD64
ARG CLAUDE_VERSION
ARG CLAUDE_SHA256_ARM64
ARG CLAUDE_SHA256_AMD64

SHELL ["/bin/bash", "-euo", "pipefail", "-c"]

# Base tools. tini is PID 1 so signals and orphaned processes are handled;
# bubblewrap is required by the Codex package even though the container, not
# Codex's own sandbox, is the security boundary.
RUN apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      bash bubblewrap ca-certificates curl git jq less openssh-client procps \
      ripgrep tini tmux zstd \
 && rm -rf /var/lib/apt/lists/*

# Fetch a URL to a path and verify its SHA-256, or fail the build.
RUN cat > /usr/local/sbin/fetch-verified <<'EOF'
#!/bin/bash
set -euo pipefail
url=$1 dest=$2 want=$3
[ -n "$want" ] || { echo "no checksum given for $url" >&2; exit 1; }
curl -fsSL --retry 3 -o "$dest" "$url"
got=$(sha256sum "$dest" | cut -d' ' -f1)
[ "$got" = "$want" ] || { echo "checksum mismatch for $url: got $got, want $want" >&2; rm -f "$dest"; exit 1; }
EOF
RUN chmod 755 /usr/local/sbin/fetch-verified

# GitHub CLI. The real binary lives under /usr/local/lib/aipa; /usr/local/bin/gh
# is a wrapper that supplies the bot token (see rootfs/).
RUN arch=$(dpkg --print-architecture) \
 && case "$arch" in \
      arm64) sum=$GH_SHA256_ARM64 ;; \
      amd64) sum=$GH_SHA256_AMD64 ;; \
      *) echo "unsupported architecture: $arch" >&2; exit 1 ;; \
    esac \
 && fetch-verified "https://github.com/cli/cli/releases/download/v${GH_VERSION}/gh_${GH_VERSION}_linux_${arch}.tar.gz" /tmp/gh.tgz "$sum" \
 && mkdir -p /usr/local/lib/aipa/gh \
 && tar -xzf /tmp/gh.tgz -C /usr/local/lib/aipa/gh --strip-components=1 \
 && rm /tmp/gh.tgz

# Codex: the full package (codex, codex-code-mode-host, bundled resources).
RUN arch=$(dpkg --print-architecture) \
 && case "$arch" in \
      arm64) triple=aarch64-unknown-linux-musl; sum=$CODEX_SHA256_ARM64 ;; \
      amd64) triple=x86_64-unknown-linux-musl; sum=$CODEX_SHA256_AMD64 ;; \
      *) echo "unsupported architecture: $arch" >&2; exit 1 ;; \
    esac \
 && fetch-verified "https://github.com/openai/codex/releases/download/rust-v${CODEX_VERSION}/codex-package-${triple}.tar.gz" /tmp/codex.tgz "$sum" \
 && mkdir -p /opt/codex \
 && tar -xzf /tmp/codex.tgz -C /opt/codex \
 && ln -s /opt/codex/bin/codex /usr/local/bin/codex \
 && rm /tmp/codex.tgz

# Claude Code: the native binary, verified against the checksum published in
# Anthropic's release manifest. Installed system-wide so the persistent home
# volume never hides it; auto-update is off so the image stays the pinned version.
RUN arch=$(dpkg --print-architecture) \
 && case "$arch" in \
      arm64) platform=linux-arm64; sum=$CLAUDE_SHA256_ARM64 ;; \
      amd64) platform=linux-x64; sum=$CLAUDE_SHA256_AMD64 ;; \
      *) echo "unsupported architecture: $arch" >&2; exit 1 ;; \
    esac \
 && fetch-verified "https://downloads.claude.ai/claude-code-releases/${CLAUDE_VERSION}/${platform}/claude" /usr/local/bin/claude "$sum" \
 && chmod 755 /usr/local/bin/claude
ENV DISABLE_AUTOUPDATER=1

# Wrappers and helpers that connect the tools to the read-only /run/aipa mount.
COPY rootfs/ /
RUN chmod 755 /usr/local/bin/gh /usr/local/bin/git-credential-aipa /usr/local/bin/aipa-sync-main \
 && git config --system credential.https://github.com.helper /usr/local/bin/git-credential-aipa \
 && git config --system credential.https://github.com.useHttpPath false \
 && git config --system --add safe.directory /work/main \
 && git config --system init.defaultBranch main

# The non-root user every agent runs as. /home/agent is a named volume at
# runtime, so anything the image needs must live outside it.
RUN useradd --create-home --uid 1000 --shell /bin/bash agent

LABEL org.opencontainers.image.source="https://github.com/dpeckham/ai-proj-arch" \
      org.opencontainers.image.licenses="Apache-2.0"

ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["sleep", "infinity"]
